<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="kdb"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Kevin Veroneau"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="A Package for managing various database units specific to my system and configuration."/>
    <License Value="LGPL"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="kdbglobal.pas"/>
        <UnitName Value="kdbglobal"/>
      </Item>
      <Item>
        <Filename Value="knotes.pas"/>
        <UnitName Value="knotes"/>
      </Item>
      <Item>
        <Filename Value="kdblog.pas"/>
        <UnitName Value="kdblog"/>
      </Item>
      <Item>
        <Filename Value="kdbvfs.pas"/>
        <UnitName Value="kdbvfs"/>
      </Item>
      <Item>
        <Filename Value="kdbtasks.pas"/>
        <UnitName Value="kdbtasks"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
